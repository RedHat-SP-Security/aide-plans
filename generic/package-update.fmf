# used in
# https://gitlab.com/redhat/centos-stream/rpms/aide

summary: package update scenario

execute:
    how: tmt

prepare:
  - how: shell
    order: 90
    script:
      # remove installed (tested) aide and any leftovers
      - dnf -y remove '*aide*'
      - rm -rf /var/log/aide /var/lib/aide /etc/aide.conf
      # install older aide
      - dnf -y install aide --disablerepo test-artifacts

discover:


  - name: Update_scenario_setup
    how: fmf
    url: https://github.com/RedHat-SP-Security/aide-tests
    ref: master
    test:
      - /Sanity/aide-check-sanity

  - name: Update_aide_package
    how: shell
    tests:
      - name: aide_update
        test: dnf -y update '*aide*'
        duration: 2m


  - name: Test_scenario_post-update
    how: fmf
    url: https://github.com/RedHat-SP-Security/aide-tests
    ref: master
    test:
      - /Sanity/aide-check-sanity
    environment:
      IN_PLACE_UPGRADE: "new"